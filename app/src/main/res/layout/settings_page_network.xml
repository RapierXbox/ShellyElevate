<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/wifiSection"
        layout="@layout/settings_wifi_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- wifi ip configuration -->
    <LinearLayout
        android:id="@+id/wifiIpSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wifi_ip_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wifiIpInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            android:textSize="14sp"
            tools:text="Network: MyWifi\nIP address: 192.168.1.50" />

        <TextView
            android:id="@+id/wifiIpPermissionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/wifi_ip_permission_hint"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/wifiIpEditLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/wifiIpUseStatic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/wifi_ip_use_static"
                android:textSize="18sp"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

            <LinearLayout
                android:id="@+id/wifiIpStaticLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wifi_ip_static_ip"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/wifiIpAddress"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:digits="0123456789."
                        android:hint="192.168.1.50"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wifi_ip_prefix"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/wifiIpPrefix"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:digits="0123456789./"
                        android:hint="24"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wifi_ip_gateway_label"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/wifiIpGateway"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:digits="0123456789."
                        android:hint="192.168.1.1"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wifi_ip_dns1"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/wifiIpDns1"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:digits="0123456789."
                        android:hint="192.168.1.1"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wifi_ip_dns2"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/wifiIpDns2"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:digits="0123456789."
                        android:hint="1.1.1.1"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:textSize="18sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>


            <Button
                android:id="@+id/wifiIpApplyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wifi_ip_apply"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/wifiIpStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Applying… waiting for Wi-Fi" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/httpServerEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/http_server_enabled"
        android:textSize="18sp"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <LinearLayout
        android:id="@+id/httpServerAddressLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/http_server_address"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/httpServerAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="0dp"
            android:textSize="18sp"
            tools:text="http://127.0.0.1:8080" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/httpServerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/httpServerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/http_server_status_default"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/httpServerStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="18sp"
            tools:text="@string/http_server_running" />

        <Button
            android:id="@+id/httpServerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="0dp"
            android:text="@string/start"
            android:textSize="18sp" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/adbWifiEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/adb_wifi_enabled"
        android:textSize="18sp"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <LinearLayout
        android:id="@+id/adbWifiAddressLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/adb_wifi_address"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/adbWifiAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="0dp"
            android:textSize="18sp"
            tools:text="192.168.1.50:5555" />
    </LinearLayout>

</LinearLayout>
