<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/volumeSettingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/volume"
            android:textSize="18sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/volumeSetting"
            style="@style/Settings.Slider"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1" />

        <TextView
            android:id="@+id/volumeValue"
            style="@style/Settings.SliderValue" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/audioOutputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:text="@string/audio_output"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/audioOutput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:spinnerMode="dialog" />
    </LinearLayout>

    <TextView
        android:id="@+id/audioOutputHint"
        style="@style/Settings.Hint"
        android:text="@string/audio_output_hint" />

    <!-- own levels with bluetooth for music only -->
    <LinearLayout
        android:id="@+id/announceVolumeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/announce_volume"
            android:textSize="18sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/announceVolume"
            style="@style/Settings.Slider"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1" />

        <TextView
            android:id="@+id/announceVolumeValue"
            style="@style/Settings.SliderValue" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/voiceReplyVolumeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/voice_reply_volume"
            android:textSize="18sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/voiceReplyVolume"
            style="@style/Settings.Slider"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1" />

        <TextView
            android:id="@+id/voiceReplyVolumeValue"
            style="@style/Settings.SliderValue" />
    </LinearLayout>
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/mediaEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/media_enabled"
        android:textSize="18sp"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <TextView
        style="@style/Settings.Hint"
        android:layout_marginStart="48dp"
        android:text="@string/media_hint" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/haVoiceEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ha_voice_enabled"
        android:textSize="18sp"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <TextView
        android:id="@+id/haVoiceHint"
        style="@style/Settings.Hint"
        android:layout_marginStart="48dp"
        android:text="@string/ha_voice_hint" />

    <!-- everything that needs the voice assistant -->
    <LinearLayout
        android:id="@+id/voiceEngineLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:orientation="vertical">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/voiceWakeEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/voice_wake_enabled"
            android:textSize="18sp"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <!-- what the wake word switch turns on -->
        <LinearLayout
            android:id="@+id/voiceWakeModelLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_wake_model_name"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/voiceWakeModelLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textSize="16sp"
                    tools:text="Hey Jarvis" />

                <Button
                    android:id="@+id/voiceWakeChooseModel"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_wake_model_choose"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/voiceWakeDownloadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/voiceWakeProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0" />

                <TextView
                    android:id="@+id/voiceWakeProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0%"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/voiceWakeModelStatus"
                style="@style/Settings.Hint"
                tools:text="Hey Jarvis is loaded" />

            <LinearLayout
                android:id="@+id/voiceWakeSensitivityLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/voice_wake_sensitivity"
                        android:textSize="18sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/voiceWakeSensitivity"
                        style="@style/Settings.Slider"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/voiceWakeSensitivityValue"
                        style="@style/Settings.SliderValue" />
                </LinearLayout>

                <TextView
                    style="@style/Settings.Hint"
                    android:text="@string/voice_wake_sensitivity_hint" />
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/voiceWakeSoundEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/voice_wake_sound"
            android:textSize="18sp"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/voiceThinkingSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/voice_thinking_sound"
            android:textSize="18sp"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <!-- what the thinking sound switch turns on -->
        <LinearLayout
            android:id="@+id/voiceThinkingOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/voiceThinkingFile"
                style="@style/Settings.Hint"
                tools:text="thinking.mp3" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/voiceThinkingLoop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/voice_thinking_loop"
                android:textSize="18sp"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

            <LinearLayout
                android:id="@+id/voiceThinkingPitchLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/voice_thinking_pitch"
                    android:textSize="18sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/voiceThinkingPitch"
                    style="@style/Settings.Slider"
                    android:valueFrom="0"
                    android:valueTo="50"
                    android:stepSize="1" />

                <TextView
                    android:id="@+id/voiceThinkingPitchValue"
                    style="@style/Settings.SliderValue" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/speakerIdEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/speaker_id"
            android:textSize="18sp"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <TextView
            android:id="@+id/speakerIdHint"
            style="@style/Settings.Hint"
            android:text="@string/speaker_id_hint" />

        <!-- what the speaker recognition switch turns on -->
        <LinearLayout
            android:id="@+id/speakerIdOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/speakerIdModelLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/speaker_id_model"
                    android:textSize="18sp" />

                <Spinner
                    android:id="@+id/speakerIdModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dialog" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/speakerIdStrictnessLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/speaker_id_strictness"
                        android:textSize="18sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/speakerIdStrictness"
                        style="@style/Settings.Slider"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/speakerIdStrictnessValue"
                        style="@style/Settings.SliderValue" />
                </LinearLayout>

                <TextView
                    style="@style/Settings.Hint"
                    android:text="@string/speaker_id_strictness_hint" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/speakerIdLearn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/speaker_id_learn"
                android:textSize="18sp"
                tools:ignore="UseSwitchCompatOrMaterialXml" />
        </LinearLayout>

        <include
            android:id="@+id/voiceAdvancedHeader"
            layout="@layout/settings_advanced_header" />

        <LinearLayout
            android:id="@+id/voiceAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/voiceAssistantMaxSecondsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:text="@string/voice_assistant_max_seconds"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/voiceAssistantMaxSeconds"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:hint="@string/voice_assistant_max_seconds_hint"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:text="@string/unit_seconds"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/voiceWakeCooldownLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/voice_wake_cooldown"
                    android:textSize="18sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/voiceWakeCooldown"
                    style="@style/Settings.Slider"
                    android:valueFrom="1"
                    android:valueTo="10"
                    android:stepSize="1" />

                <TextView
                    android:id="@+id/voiceWakeCooldownValue"
                    style="@style/Settings.SliderValue" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
