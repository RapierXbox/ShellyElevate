<?xml version="1.0" encoding="utf-8"?>
<!-- wifi scan and connect section included by settings_page_network and driven by WifiSettingsSection -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wifi_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wifiCurrent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        tools:text="Connected to MyNetwork · -59 dBm · 2.4 GHz · 192.168.1.50" />

    <TextView
        android:id="@+id/wifiHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="@string/wifi_hint_permission"
        tools:visibility="visible" />

    <Button
        android:id="@+id/wifiHintButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="@string/wifi_grant_permission"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/wifiScanButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wifi_scan"
            android:textSize="16sp" />

        <Button
            android:id="@+id/wifiAddHiddenButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/wifi_add_hidden"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/wifiProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:indeterminate="true"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/wifiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="@string/wifi_scanning"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/wifiEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/wifi_no_networks"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/wifiNetworkList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

</LinearLayout>
