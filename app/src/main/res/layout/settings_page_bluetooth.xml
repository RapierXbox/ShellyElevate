<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ─────────────── Bluetooth Proxy ─────────────── -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/bluetoothProxyEnabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/bt_proxy_enabled"
        android:textSize="18sp"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <LinearLayout
        android:id="@+id/bluetoothProxyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="@string/bt_proxy_name"
                android:textSize="18sp" />
            <EditText
                android:id="@+id/bluetoothProxyName"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:hint="@string/bt_proxy_name_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/bluetoothProxyAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            tools:text="Add to HA: 192.168.1.100:6053" />

    </LinearLayout>

</LinearLayout>
